{
  "name": "vr017-presentacion-ritmo",
  "version": "1.0.0",
  "private": true,
  "description": "VR017 - Presentación global de la app al ritmo de la música (Remotion, vertical + horizontal, 60 fps)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:v": "remotion render src/index.ts VR017-Vertical out/VR017_V_raw.mp4 --crf=16 --pixel-format=yuv420p",
    "render:h": "remotion render src/index.ts VR017-Horizontal out/VR017_H_raw.mp4 --crf=16 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/cli": "4.0.448",
    "@remotion/fonts": "4.0.448",
    "@remotion/media": "4.0.448",
    "remotion": "4.0.448",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
