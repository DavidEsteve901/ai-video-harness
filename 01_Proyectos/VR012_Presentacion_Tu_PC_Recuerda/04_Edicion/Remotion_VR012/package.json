    "render:h": "remotion render src/index.ts VR012-Horizontal out/VR012_H_1920x1080_60fps.mp4 --crf=16 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/cli": "4.0.448",
    "@remotion/fonts": "4.0.448",
    "@remotion/media": "4.0.448",
    "remotion": "4.0.448",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
