{
  "name": "vr012-presentacion-tu-pc-recuerda",
  "version": "1.0.0",
  "private": true,
  "description": "VR012 - Presentación de Workspace Launcher: «Tu ordenador tiene amnesia» (Remotion, vertical + horizontal)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
